VITE_BASE=/

# 接口地址（正式后端接入前，构建产物不包含可用的业务 Mock 服务）
VITE_GLOB_API_URL=/api

# 正式环境没有 Nitro 业务 Mock
VITE_NITRO_MOCK=false
VITE_APP_MOCK_BUSINESS=false

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成 dist.zip（M0 构建验证不需要）
VITE_ARCHIVER=false
