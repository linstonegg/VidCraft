# 端口号（控制台实际地址为准）
VITE_PORT=5555

VITE_BASE=/

# 接口地址（Vben 基础 URL，业务路径为 /creative-video/v1/...）
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock 服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# VidCraft 业务 Mock 标识开关（前端展示“演示模式”Banner 使用）
VITE_APP_MOCK_BUSINESS=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=true

# 是否注入全局 loading
VITE_INJECT_APP_LOADING=true
